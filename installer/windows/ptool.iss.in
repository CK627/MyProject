; ptool Windows 安装脚本（Inno Setup 6）
;
; 由 build-from-mac.sh 渲染：@TOOL@ / @VERSION@ / @APPID@ 会被替换成实际值。
; 刻意不使用 Inno 的预处理器（ISPP）语法，纯文本替换即可，少一个依赖。
;
; 目录约定（构建时组装，Source 路径相对于本文件所在目录）：
;   src\bin\ptool.bat         运行时主脚本
;   src\config\ptool.conf     配置文件（已写入版本号）
;   src\module\install.bat    供 ptool install / ptool scan 调用
;   src\VERSION               版本号，install.bat 的 :write_version 依赖它

[Setup]
AppId={{@APPID@}
AppName=@TOOL@
AppVersion=@VERSION@
AppVerName=@TOOL@ @VERSION@
AppPublisher=CK627
DefaultDirName={autopf}\devtools\@TOOL@
DisableDirPage=yes
DisableProgramGroupPage=yes
OutputDir=.
OutputBaseFilename=@TOOL@-setup-@VERSION@
Compression=lzma2/max
SolidCompression=yes
; 必须声明 64 位安装模式，否则 {autopf} 会解析成 C:\Program Files (x86)。
; bin\@TOOL@.bat 是从自身位置推导安装目录的，两者不一致会让 update 写错地方。
ArchitecturesInstallIn64BitMode=x64compatible
; 机器级安装必须提权。不加 PrivilegesRequiredOverridesAllowed：
; 否则非提权运行会退化成每用户安装，而写 HKLM 的 PATH 会静默失败。
PrivilegesRequired=admin
ChangesEnvironment=yes
UninstallDisplayName=@TOOL@ @VERSION@
WizardStyle=modern
DisableWelcomePage=no

[Files]
Source: "src\bin\@TOOL@.bat";       DestDir: "{app}\bin";     Flags: ignoreversion
Source: "src\module\install.bat";   DestDir: "{app}\module";  Flags: ignoreversion
Source: "src\VERSION";              DestDir: "{app}";         Flags: ignoreversion
; 配置文件只在不存在时安装，升级时保留用户已有的设置
Source: "src\config\@TOOL@.conf";   DestDir: "{app}\config";  Flags: onlyifdoesntexist

[Dirs]
; 这两个目录都不给普通用户写权限，刻意如此：
;   config  里的默认版本决定机器级 shim 去执行哪个 python.exe。放开写权限
;           等于「普通用户能让管理员执行任意 python.exe」，是本地提权口子。
;   shims   被前置到机器级 PATH 上，可写同样等于让普通用户替换全机器都会
;           执行的命令。只读 + 执行（从 {app} 继承，install.bat 也显式授了 RX）。
; 代价：ptool use / ptool scan 需要提权。
Name: "{app}\config"
Name: "{app}\shims"

[InstallDelete]
; 旧版把 shim 写在用户级目录、并把那个目录加到用户 PATH。升级时清掉脚本本身，
; 同级的 repo（update 的克隆缓存）保留。PATH 里那条遗留项由
; CurStepChanged(ssPostInstall) 摘掉。
Type: filesandordirs; Name: "{%USERPROFILE}\.devtools\@TOOL@\shims"

[Registry]
; 把 bin 目录追加到机器级 PATH。
;   {olddata}  保留已有内容
;   preservestringtype  维护原有的 REG_SZ / REG_EXPAND_SZ 类型
;   NeedsAddPath  已存在时不重复追加（重复安装/升级的关键）
Root: HKLM; Subkey: "SYSTEM\CurrentControlSet\Control\Session Manager\Environment"; \
  ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};{app}\bin"; \
  Flags: preservestringtype; Check: NeedsAddPath('{app}\bin')

; 把 shims 目录前插到机器级 PATH。
; 必须是机器级、且必须在最前：Windows 的生效 PATH = 机器级 Path + ';' + 用户级
; Path，机器级永远在前。旧版把 shim 放在用户级目录里，无论排用户级第几位，
; 都排在机器级 PATH 里的 python.exe 之后，于是裸敲 python 走的是系统那个
; 而不是 ptool 设的默认版本 —— shim 成了死代码。
; 上面两条写的是同一个值，最终顺序不靠「{olddata} 会不会读到上一条刚写过的值」
; —— 那个语义官方文档没说清，赌错就会把 {app}\bin 冲掉。顺序由下面 [Code] 里的
; SetMachinePathOrder 在 ssPostInstall 定死：{app}\shims 最前，{app}\bin 最后。
Root: HKLM; Subkey: "SYSTEM\CurrentControlSet\Control\Session Manager\Environment"; \
  ValueType: expandsz; ValueName: "Path"; ValueData: "{app}\shims;{olddata}"; \
  Flags: preservestringtype; Check: NeedsAddPath('{app}\shims')

[Run]
; 安装后自动扫描一次，把配置里的 PYTHON_BASE_DIR 换成这台机器上的真实位置。
; 随包发的配置带的是 Windows 默认值，扫描成功会被覆盖成实际检测结果。
; 这一步同时会把「扫到的最高版本」写成默认版本（install.bat 的
; :pick_best_version），因为前插的 shim 必须马上能解析出版本。
Filename: "{app}\module\install.bat"; Parameters: "scansilent"; \
  Flags: runhidden waituntilterminated; \
  StatusMsg: "正在扫描 Python 安装路径..."

; 扫描之后生成 shims（依赖 config 已存在），把 python/python3/pip/pip3
; 转发脚本写入 {app}\shims，该目录已由上面的 [Registry] 前插到机器级 PATH
Filename: "{app}\bin\ptool.bat"; Parameters: "shim"; \
  Flags: runhidden waituntilterminated; \
  StatusMsg: "正在生成 shim..."

[UninstallDelete]
; 清掉用户级产物（shim / update 的仓库缓存）。只覆盖执行卸载的那个用户。
Type: filesandordirs; Name: "{%USERPROFILE}\.devtools\@TOOL@"

; shims 目录必须显式声明，否则卸载完会剩下一整个目录加一个删不掉的卸载器。
;
; 里面的转发脚本是安装时由 @TOOL@.bat shim 生成的，不在 [Files] 里，卸载日志中
; 没有这些文件，于是 Inno 把 {app}\shims 当成「非空目录」——RemoveDir 失败（145），
; 紧接着 {app} 也删不掉，最后留在盘上的是 shims\ 和 unins000.exe。实测日志：
;     Deleting directory: ...\shims → Failed to delete directory (145). Will retry later.
;     Deleting directory: ...\      → Failed to delete directory (145). Will retry later.
; （2.3.2 把 shim 从用户级目录搬进 {app}\shims 之前没有这个问题。）
;
; 时机正好：卸载顺序是 [UninstallRun] → 注册表 → 图标 → 文件 → {app} →
; [UninstallDelete] → 再来一次删目录（就是 "Will retry later" 的那次重试）。
; 在这里把 shims 清掉，重试时 {app} 已经空了，重试就能成功。
Type: filesandordirs; Name: "{app}\shims"
;
; 但不要顺手把它换成 "{app}"。{app} 里还有第一阶段正在运行的 unins000.exe 和
; 它占用的 unins000.dat，扫进去必然失败（错误 5 / 32），反而把 unins000.dat 的
; 正常删除也一起搞坏，结果是每卸载一次留一个 unins000.exe，下次安装发现名字被占，
; 卸载器顺延成 unins001.exe 逐次累积。Inno 官方对 Name 参数的说明里也明确写了
; 不要把 {app} 通配进来（"DON'T DO THIS"）。shims 是我们自己生成的固定目录，不在此列。

[Code]
const
  EnvironmentKey = 'SYSTEM\CurrentControlSet\Control\Session Manager\Environment';
  UserEnvironmentKey = 'Environment';
  // HWND_BROADCAST / WM_SETTINGCHANGE / SMTO_ABORTIFHUNG 由 Inno 的 Pascal
  // Script 预定义，不要再声明一遍（会报 Duplicate identifier）

// 去掉首尾空白和结尾的反斜杠，再统一大小写。
// Windows 的 PATH 比较必须这样处理：注册表里可能存着 C:\PROGRA~1\... 这类短名，
// 也可能带结尾反斜杠。
function NormalizeEntry(S: string): string;
begin
  S := Trim(S);
  while (Length(S) > 0) and (S[Length(S)] = '\') do
    Delete(S, Length(S), 1);
  Result := Uppercase(S);
end;

// 按 ';' 分段比较，而不是整串子串匹配 —— 后者会被 "C:\a" 命中 "C:\ab"，
// 也处理不了段内带结尾反斜杠的情况
function PathContains(Path, Entry: string): Boolean;
var
  Rest, Seg: string;
  P: Integer;
begin
  Result := False;
  Rest := Path;
  while Rest <> '' do
  begin
    P := Pos(';', Rest);
    if P > 0 then
    begin
      Seg := Copy(Rest, 1, P - 1);
      Delete(Rest, 1, P);
    end
    else
    begin
      Seg := Rest;
      Rest := '';
    end;
    if (Seg <> '') and (NormalizeEntry(Seg) = NormalizeEntry(Entry)) then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

function NeedsAddPath(Param: string): Boolean;
var
  OrigPath, Target: string;
begin
  // 关键: Check 参数里的常量不一定被展开，必须自己展开一次。
  // 少了这一步，Param 会是字面量 '{app}\bin'，永远匹配不上，
  // 每装一次就往 PATH 里追加一条重复项。
  // （已展开的字符串不含 {}，ExpandConstant 是幂等的）
  Target := ExpandConstant(Param);
  Result := True;

  if not RegQueryStringValue(HKLM, EnvironmentKey, 'Path', OrigPath) then
  begin
    Log('NeedsAddPath: 读取 Path 失败，将直接追加 ' + Target);
    Exit;
  end;

  if PathContains(OrigPath, Target) then
  begin
    Log('NeedsAddPath: 已存在，跳过 ' + Target);
    Result := False;
  end
  else
    Log('NeedsAddPath: 未找到，将追加 ' + Target);
end;

// 外科式移除，而不是 uninsdeletevalue —— 后者会清空整个 Path，把机器 PATH 毁掉
procedure RemoveFromPath(Param: string);
var
  OrigPath, NewPath, Rest, Seg: string;
  P: Integer;
begin
  if not RegQueryStringValue(HKLM, EnvironmentKey, 'Path', OrigPath) then
    Exit;

  NewPath := '';
  Rest := OrigPath;
  while Rest <> '' do
  begin
    P := Pos(';', Rest);
    if P > 0 then
    begin
      Seg := Copy(Rest, 1, P - 1);
      Delete(Rest, 1, P);
    end
    else
    begin
      Seg := Rest;
      Rest := '';
    end;

    if (Seg <> '') and (NormalizeEntry(Seg) <> NormalizeEntry(Param)) then
    begin
      if NewPath <> '' then
        NewPath := NewPath + ';';
      NewPath := NewPath + Seg;
    end;
  end;

  RegWriteExpandStringValue(HKLM, EnvironmentKey, 'Path', NewPath);
  Log('RemoveFromPath: 已移除 ' + Param);
end;

// NeedsAddPath 只管 HKLM。旧版往 HKCU 写 shims 那条记录已经删掉了：
// 用户级 PATH 整体排在机器级之后，写得再靠前也压不过机器级里的 python.exe。
// 现在只有 RemoveFromUserPath 还会碰 HKCU，用途是清理旧版遗留项。
procedure RemoveFromUserPath(Param: string);
var
  OrigPath, NewPath, Rest, Seg: string;
  P: Integer;
begin
  if not RegQueryStringValue(HKCU, UserEnvironmentKey, 'Path', OrigPath) then
    Exit;
  NewPath := '';
  Rest := OrigPath;
  while Rest <> '' do
  begin
    P := Pos(';', Rest);
    if P > 0 then
    begin
      Seg := Copy(Rest, 1, P - 1);
      Delete(Rest, 1, P);
    end
    else
    begin
      Seg := Rest;
      Rest := '';
    end;
    if (Seg <> '') and (NormalizeEntry(Seg) <> NormalizeEntry(Param)) then
    begin
      if NewPath <> '' then
        NewPath := NewPath + ';';
      NewPath := NewPath + Seg;
    end;
  end;
  RegWriteExpandStringValue(HKCU, UserEnvironmentKey, 'Path', NewPath);
  Log('RemoveFromUserPath: 已移除 ' + Param);
end;

// 机器级 PATH 的最终顺序由这里定死，不靠 [Registry] 那两条记录的顺序。
//
// 上面两条记录写的是同一个值（HKLM 的 Path），第二条的 {olddata} 到底取到
// 「第一条刚写过的值」还是「Setup 动手之前的值」，官方文档只写了
// "{olddata} is replaced with the previous data of the registry value"，
// 没有说清。若是后者，第二条就会把第一条追加的 {app}\bin 冲掉——裸敲
// ptool 直接找不到命令。这个风险不能留：
//   · exe 安装包走的是 [Registry] + [Run]，install.bat 的 [4/4] 根本不会跑
//     （[Run] 只调 scansilent），所以没有第二道保险。
//   · 只有仓库布局直接跑 install.bat 时才由 [4/4] 归一化。
// 这里在 ssPostInstall 兜一刀，把结果做成确定的、与上面那种语义无关的：
//   {app}\shims 在最前（才压得过机器级 PATH 上已有的 python.exe），
//   {app}\bin 在最后。幂等：装几遍、装的是全新还是升级，结果都一样。
procedure SetMachinePathOrder;
var
  OrigPath, NewPath, Rest, Seg, Shims, Bin: string;
  P: Integer;
begin
  Shims := ExpandConstant('{app}\shims');
  Bin := ExpandConstant('{app}\bin');
  if not RegQueryStringValue(HKLM, EnvironmentKey, 'Path', OrigPath) then
  begin
    Log('SetMachinePathOrder: 读取 Path 失败，跳过');
    Exit;
  end;

  NewPath := '';
  Rest := OrigPath;
  while Rest <> '' do
  begin
    P := Pos(';', Rest);
    if P > 0 then
    begin
      Seg := Copy(Rest, 1, P - 1);
      Delete(Rest, 1, P);
    end
    else
    begin
      Seg := Rest;
      Rest := '';
    end;
    // 先把两条目标项摘掉，剩下的原样保留（含其他程序的项）
    if (Seg <> '') and (NormalizeEntry(Seg) <> NormalizeEntry(Shims)) and
       (NormalizeEntry(Seg) <> NormalizeEntry(Bin)) then
    begin
      if NewPath <> '' then
        NewPath := NewPath + ';';
      NewPath := NewPath + Seg;
    end;
  end;

  if NewPath <> '' then
    NewPath := Shims + ';' + NewPath + ';' + Bin
  else
    NewPath := Shims + ';' + Bin;

  RegWriteExpandStringValue(HKLM, EnvironmentKey, 'Path', NewPath);
  Log('SetMachinePathOrder: 已重排机器级 Path');
end;

// 安装收尾时兜住旧版遗留的用户级 PATH 项。
// [Registry] 里对应的记录已经删掉，但老版本装过的机器上那条还在，而且
// 用户 PATH 里指向一个已被 [InstallDelete] 删掉的目录。什么时候兜不住：
// 旧卸载器没跑成（被手工删过 {app}），或跨多个版本直接跳升。这里补一刀。
// 位置在 ssPostInstall：[Registry] 已经处理完，改的是另一个 hive，不冲突。
procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    SetMachinePathOrder;
    RemoveFromUserPath(ExpandConstant('{%USERPROFILE}\.devtools\@TOOL@\shims'));
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  // 注意：Inno 的 Pascal Script 没有 SendMessageTimeout（编译期会报
  // Unknown identifier），所以这里无法手动广播 WM_SETTINGCHANGE。
  // 环境变量变更的通知交给 [Setup] 的 ChangesEnvironment=yes，
  // 它同时覆盖安装与卸载两个阶段。
  //
  // 用 usUninstall 而不是 usPostUninstall。实测（Windows 10 19045 /
  // Inno 6.7.3）: usPostUninstall 不触发 —— 日志里只见到 step=0 和 step=1，
  // 原因没定位。usUninstall 稳定触发，且此时改注册表不会被卸载器回滚
  // （本脚本没有用任何 uninsdelete* 标志，Inno 不会自动还原 Path）。
  if CurUninstallStep = usUninstall then
  begin
    RemoveFromPath(ExpandConstant('{app}\bin'));
    RemoveFromPath(ExpandConstant('{app}\shims'));
    RemoveFromUserPath(ExpandConstant('{%USERPROFILE}\.devtools\@TOOL@\shims'));
  end;
end;

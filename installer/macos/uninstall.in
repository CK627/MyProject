#!/bin/bash
# @TOOL@ 卸载程序
#
# macOS 的 flat pkg 没有卸载钩子，所以安装包会把这个脚本放到安装目录里，
# 用户手动执行即可。flat pkg 没有内置卸载机制，这是唯一的入口。
#
# 用法:
#   sudo /Library/devtools/@TOOL@/uninstall        # 交互确认
#   sudo /Library/devtools/@TOOL@/uninstall -y     # 跳过确认

TOOL="@TOOL@"
INSTALL="/Library/devtools/$TOOL"

if [ "$(/usr/bin/id -u)" -ne 0 ]; then
    /bin/echo "需要管理员权限，请用: sudo $0" >&2
    exit 1
fi

case "${1:-}" in
    -y|--yes) ;;
    *)
        /bin/echo -n "确定要卸载 $TOOL 吗？(y/n): "
        read -r ans
        case "$ans" in
            y|Y) ;;
            *) /bin/echo "已取消"; exit 0 ;;
        esac
        ;;
esac

# ---------------------------------------------------------------
# 用户级清理：以控制台登录用户身份处理 shell 配置
#   shim 与补全现在都在 $INSTALL 里（下面 rm -rf 一并删掉），这里处理的是
#   - 2.2.18 之前遗留在 ~/.devtools/$TOOL 下的老目录
#   - rc 里指向老路径的那几行
# ---------------------------------------------------------------
TARGET="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)"
case "$TARGET" in
    ""|root|loginwindow) TARGET="" ;;
esac

if [ -n "$TARGET" ] && /usr/bin/id -u "$TARGET" >/dev/null 2>&1; then
    UHOME="$(/usr/bin/dscl . -read "/Users/$TARGET" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
    [ -n "$UHOME" ] || UHOME="/Users/$TARGET"

    # 清掉 shell 配置里由安装程序写入的行（标记行 + PATH 行 + 补全 source 行）。
    # $INSTALL 覆盖新布局；~/.devtools/$TOOL/* 覆盖老布局。
    for rc in "$UHOME/.zshrc" "$UHOME/.bashrc" "$UHOME/.bash_profile"; do
        [ -f "$rc" ] || continue
        /usr/bin/sed -i '' "/^# $TOOL$/d" "$rc"
        for d in "$INSTALL" "$UHOME/.devtools/$TOOL/shims" "$UHOME/.devtools/$TOOL/completions"; do
            /usr/bin/sed -i '' "\|$d|d" "$rc"
        done
        /bin/echo "已清理: $rc"
    done

    if [ -d "$UHOME/.devtools/$TOOL" ]; then
        /usr/bin/sudo -u "$TARGET" /bin/rm -rf "$UHOME/.devtools/$TOOL"
        /bin/echo "已删除老布局残留: $UHOME/.devtools/$TOOL"
    fi
    # 只在空的时候删（rmdir 非空会失败），别人的东西不受影响
    /usr/bin/sudo -u "$TARGET" /bin/rmdir "$UHOME/.devtools" 2>/dev/null
else
    /bin/echo "未检测到登录用户，跳过 shell 配置清理"
    /bin/echo "如需清理，请手动编辑 rc 文件，移除 $TOOL 相关的行"
fi

# ---------------------------------------------------------------
# 系统级
# ---------------------------------------------------------------
/usr/sbin/pkgutil --forget "com.ck627.$TOOL" >/dev/null 2>&1
/bin/rm -rf "$INSTALL"
/bin/echo "$TOOL 已卸载"

exit 0
